<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
	<section class="user_info">
    <%= render "shared/user_info" %>
	</section>
  </aside>

  <div class="col-md-8">
    <% if @microposts.any? %>
      <h3><%= t("users.show.microposts_heading", count: @microposts.count) %></h3>
      <ol class="microposts">
      <%= render @microposts %>
      </ol>
      <%== pagy_bootstrap_nav @page %>
    <% end %>
  </div>
</div>
